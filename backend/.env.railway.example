# ---------------------------------------------------------------------------
# Railway MySQL connection for the hosted database.
#
# HOW TO USE
#   1. Copy this file to  backend/.env.railway  (that copy is ignored by Git).
#   2. Fill in the 5 empty values below from the Railway dashboard.
#   3. Run the commands listed at the bottom of this file.
#
# Your local backend/.env is never read or changed by these steps.
# ---------------------------------------------------------------------------

# --- STEP A: Railway -> MySQL -> Settings -> Networking -> Public Access ----
# Railway shows an address such as:   shuttle.proxy.rlwy.net:15140
#   the part BEFORE the colon is DB_HOST   (example: shuttle.proxy.rlwy.net)
#   the number AFTER the colon is DB_PORT  (example: 15140)
# Do NOT use MYSQLHOST / MYSQLPORT from the Variables tab
# (mysql.railway.internal and 3306 work only inside Railway).
DB_HOST=
DB_PORT=

# --- STEP B: Railway -> MySQL -> Variables (click the eye icon to reveal) ---
# DB_USER     = value of MYSQLUSER       (normally: root)
# DB_PASSWORD = value of MYSQLPASSWORD   (paste it exactly, no quotes)
# DB_NAME     = value of MYSQLDATABASE   (normally: railway)
DB_USER=root
DB_PASSWORD=
DB_NAME=railway

# Encrypts the connection across the public internet. Change to false only if
# the script reports that the server does not support secure connections.
DB_SSL=true

# --- STEP C: the first administrator account for the website ----------------
# Choose your own email and a strong password (at least 12 characters).
# NODE_ENV=production makes a missing ADMIN_PASSWORD an error instead of
# falling back to the local development password. Leave it as it is.
NODE_ENV=production
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Smart Community Admin

# ---------------------------------------------------------------------------
# STEP D: run these from the project root folder, one line at a time.
#
#   Create the tables (refuses to run if the database already has tables):
#     npm run bootstrap-db -- --env-file backend/.env.railway --apply
#
#   Create the administrator account:
#     node --env-file=backend/.env.railway backend/src/scripts/seedAdmin.js
#
#   Check the connection (prints the number of users):
#     node --env-file=backend/.env.railway backend/src/scripts/checkDb.js
#
# STEP E: in Vercel -> Project -> Settings -> Environment Variables, add the
# same DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME and DB_SSL=true for
# Production and Preview, then redeploy.
# ---------------------------------------------------------------------------
