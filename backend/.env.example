# Database
DB_HOST=127.0.0.1
DB_USER=smart_community
# Use a unique password. The compose.yaml value is local-development only.
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=final_pro
DB_PORT=3306
# Required for TLS-hosted databases such as Aiven. Paste the CA certificate;
# Render supports multiline environment-variable values. Leave empty locally.
DB_SSL_CA=
# Railway MySQL has no public CA: set true to encrypt without verifying the
# certificate. Ignored when DB_SSL_CA is set. Leave false locally.
DB_SSL=false
PORT=4000

# Frontend and JWT
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
APP_URL=http://localhost:5173
# Generate at least 32 random characters; never reuse the example value.
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_ISSUER=smart-community-api
JWT_AUDIENCE=smart-community-web
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Administrator bootstrap (run manually with: npm run seed:admin)
ADMIN_EMAIL=admin@smartcommunity.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_NAME=Smart Community Admin

# Keep true in production. Set false only for a controlled team-testing period.
REQUIRE_EMAIL_VERIFICATION=true

# Google Identity Services (same ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Hosted email over HTTPS (recommended for Render free services)
RESEND_API_KEY=

# Sender must use a domain verified by the selected provider. During Resend
# account testing, onboarding@resend.dev can send only to the account owner.
EMAIL_FROM=Smart Community <onboarding@resend.dev>

# Optional SMTP fallback (development links are returned locally when both
# Resend and SMTP are empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Profile images (uses backend/uploads locally when these are empty)
API_PUBLIC_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Firebase Cloud Messaging service account
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Bakong KHQR course payments
# Local development can also read these values from bakong-main/bakong-main/backend/.env.
BAKONG_ACCOUNT_USERNAME=your_bakong_account_id@bank
BAKONG_ACCOUNT_NAME=Smart Community
BAKONG_ACCESS_TOKEN=
BAKONG_PROD_BASE_API_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_MERCHANT_CITY=PHNOM PENH
