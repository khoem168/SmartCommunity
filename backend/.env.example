# Database
DB_HOST=127.0.0.1
DB_USER=smart_community
DB_PASSWORD=change_me
DB_NAME=final_pro
DB_PORT=3306
PORT=4000

# Frontend and JWT
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
APP_URL=http://localhost:5173
JWT_SECRET=generate_a_long_random_secret
JWT_ISSUER=smart-community-api
JWT_AUDIENCE=smart-community-web
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Google Identity Services (same ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# SMTP email (development links are returned locally when these are empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Smart Community <no-reply@example.com>

# Profile images (uses backend/uploads locally when these are empty)
API_PUBLIC_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Firebase Cloud Messaging service account
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
