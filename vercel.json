{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix frontend_user",
  "buildCommand": "npm run build --prefix frontend_user",
  "outputDirectory": "frontend_user/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
