{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/server.js",
      "installCommand": "npm ci"
    },
    "frontend_admin": {
      "root": "frontend_admin",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/admin-console/index.html" }]
    },
    "frontend_user": {
      "root": "frontend_user",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "telegram_bot": {
      "root": "telegram_bot",
      "framework": "express",
      "entrypoint": "server.js",
      "installCommand": "npm ci"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/socket.io/:path*", "destination": { "service": "backend" } },
    { "source": "/uploads/:path*", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    {
      "source": "/admin-console",
      "destination": { "service": "frontend_admin" }
    },
    {
      "source": "/admin-console/(.*)",
      "destination": { "service": "frontend_admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend_user" }
    }
  ]
}
